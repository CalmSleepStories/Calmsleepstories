# Copy this file to .env for local testing.
# In GitHub Actions, set these as repository Secrets instead (Settings -> Secrets and variables -> Actions).

GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token

# Optional tuning
VIDEO_MINUTES=20
TTS_VOICE=en-US-JennyNeural
TTS_RATE=-15%
CHANNEL_MADE_FOR_KIDS=false
